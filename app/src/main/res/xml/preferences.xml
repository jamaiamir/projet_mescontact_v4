<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_cat_affichage">

        <ListPreference
            app:key="taille_police"
            app:title="@string/pref_taille_title"
            app:icon="@drawable/ic_text_size"
            app:entries="@array/tailles_libelles"
            app:entryValues="@array/tailles_valeurs"
            app:defaultValue="16"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="couleur_preferee"
            app:title="@string/pref_couleur_title"
            app:icon="@drawable/ic_palette"
            app:entries="@array/couleurs_libelles"
            app:entryValues="@array/couleurs_valeurs"
            app:defaultValue="#000000"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_liste">

        <SwitchPreferenceCompat
            app:key="appel_depuis_liste"
            app:title="@string/pref_appel_title"
            app:icon="@drawable/ic_call_dark"
            app:defaultValue="false"
            app:summaryOn="@string/pref_appel_on"
            app:summaryOff="@string/pref_appel_off" />

        <!-- Bonus : ordre de tri appliqué par la clause ORDER BY -->
        <ListPreference
            app:key="ordre_tri"
            app:title="@string/pref_tri_title"
            app:icon="@drawable/ic_sort"
            app:entries="@array/tri_libelles"
            app:entryValues="@array/tri_valeurs"
            app:defaultValue="favoris"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
</PreferenceScreen>
